{
  "name": "@orchestrum/core",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "orchestrum-core": "bin/orchestrum-core.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "cross-env NODE_OPTIONS=--conditions=source node --import tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--conditions=source vitest run test/all.test.ts --testTimeout=30000 --hookTimeout=30000",
    "coverage": "cross-env NODE_OPTIONS=--conditions=source vitest run test/all.test.ts --coverage --testTimeout=30000 --hookTimeout=30000"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "playwright": "^1.53.2",
    "sql.js": "^1.13.0",
    "tar": "^7.4.3",
    "tsx": "^4.16.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "keytar": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/coverage-v8": "^2.1.8",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  }
}
