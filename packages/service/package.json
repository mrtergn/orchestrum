{
  "name": "@orchestrum/service",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prebuild": "npm --prefix ../core run build",
    "dev": "cross-env NODE_OPTIONS=--conditions=source node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "cross-env NODE_OPTIONS=--conditions=source vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@orchestrum/core": "file:../core",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "tsx": "^4.16.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.8"
  },
  "bin": {
    "orchestrum-service": "dist/server.js"
  }
}
